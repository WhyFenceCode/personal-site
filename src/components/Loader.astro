---
import { site } from '../lib/config';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const steps = t(lang, 'loader.steps') as string[];
---
<div id="loader" aria-hidden="true"></div>
{site.interactive.build && (
  <a class="ld-build" href={`/${lang}/build/`} data-ld-build data-astro-reload hidden>
    <span class="ld-build-t">{t(lang, 'build.callout')} <kbd>⇧ B</kbd></span>
    <span class="ld-build-w mono">{t(lang, 'build.motion')}</span>
  </a>
)}
<div class="ld-ui wrap" id="ld-ui" role="status" aria-label="Loading" data-steps={JSON.stringify(steps)}>
  <div class="ld-top"><span class="ld-brand">{site.name}</span><button class="ld-skip mono" type="button" id="ld-skip">{t(lang, 'loader.skip')}</button></div>
  <div></div>
  <div class="ld-bottom"><span class="ld-count stat" id="ld-num" aria-hidden="true">0</span><span class="mono" id="ld-log">{steps[0]}</span></div>
</div>

<style>
  #loader, .ld-ui { display: none; }
  :global(html.intro) #loader { display: block; position: fixed; inset: 0; z-index: 88; background: #E6E6E6; }
  :global(html.intro) .ld-ui { display: grid; position: fixed; inset: 0; z-index: 95; pointer-events: none; color: #fff; mix-blend-mode: difference; grid-template-rows: var(--header-h) 1fr auto; padding-top: env(safe-area-inset-top, 0px); padding-bottom: max(16px, env(safe-area-inset-bottom, 0px)); }
  .ld-ui { --fg: #fff; }
  .ld-top { display: flex; justify-content: space-between; align-items: center; }
  .ld-brand { font-family: var(--font-display); font-weight: 800; font-stretch: 87.5%; font-size: 20px; text-transform: uppercase; }
  .ld-bottom { display: flex; justify-content: space-between; align-items: end; gap: 16px; }
  .ld-count { font-size: clamp(120px, 24vw, 380px); line-height: .8; font-variant-numeric: tabular-nums; }
  /* "Watch it build" callout, over the loader's ink (no blending, so the accent stays the accent): a dark card with
     the accent as a touch (its square, the key and a thin edge), not a fill. */
  .ld-build { display: none; }
  :global(html.intro) .ld-build:not([hidden]) { position: fixed; right: var(--gutter-r); bottom: max(16px, env(safe-area-inset-bottom, 0px)); z-index: 97; display: grid; justify-items: end; gap: 6px;
    padding: 12px 20px; border-radius: 16px; background: #161616; color: #fff; border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); text-decoration: none; box-shadow: 0 16px 40px -18px rgb(0 0 0 / .5); transition: border-color .3s;
    animation: ld-in .6s .4s cubic-bezier(.2, .7, .1, 1) both; }
  .ld-build:hover { border-color: var(--accent); }
  .ld-build-t { font-size: 15px; display: inline-flex; gap: 8px; align-items: center; }
  .ld-build-t::before { content: ""; width: 8px; height: 8px; background: var(--accent); }
  .ld-build kbd { color: var(--accent); font-weight: 700; }
  .ld-build-w { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
  @keyframes ld-in { from { opacity: 0; transform: translateY(10px); } }
  /* It takes the place of the loading-step text in the bottom-right corner. */
  :global(html.ld-callout) #ld-log { visibility: hidden; }
  .ld-skip { pointer-events: auto; background: none; color: inherit; border: 1.5px solid currentColor; border-radius: 999px; padding: 6px 14px; cursor: pointer; }
</style>
