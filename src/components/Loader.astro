---
import { site } from '../lib/config';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const steps = t(lang, 'loader.steps') as string[];
// site.yaml features.loaderStyle. console: a welcome line types out with a block cursor, the steps log below it.
const consoleStyle = site.features.loaderStyle === 'console';
const welcome = t(lang, 'loader.welcome', { host: new URL(site.url).host, name: site.name });
---
<div id="loader" aria-hidden="true"></div>
<div class="ld-hue" aria-hidden="true"></div>
{/* The console line sits on its own layer, outside the inverting UI, so its cursor can be the real accent; the ink
    spreads over it from the cursor. */}
{consoleStyle && (
  <div class="ld-term wrap" aria-hidden="true">
    <p class="ld-line" style={`--len:${welcome.length + 3}`}><span class="ld-prompt">&gt;</span><span id="ld-text"></span><span class="ld-caret" id="ld-caret"></span></p>
    <ol class="ld-steps" id="ld-steps"></ol>
  </div>
)}
{site.interactive.build && (
  <a class="ld-build" href={`/${lang}/build/`} data-ld-build data-astro-reload hidden>
    <span class="ld-build-t">{t(lang, 'build.callout')} <kbd>⇧ B</kbd></span>
    <span class="ld-build-w mono">{t(lang, 'build.motion')}</span>
  </a>
)}
<div class:list={['ld-ui wrap', { 'ld-console': consoleStyle }]} id="ld-ui" role="status" aria-label="Loading" data-steps={JSON.stringify(steps)} data-style={site.features.loaderStyle} data-welcome={welcome}>
  <div class="ld-top"><span class="ld-brand">{site.name}</span><button class="ld-skip mono" type="button" id="ld-skip">{t(lang, 'loader.skip')}</button></div>
  <div></div>
  <div class="ld-bottom">
    {consoleStyle ? <span class="mono" id="ld-pct">0%</span> : <span class="ld-count stat" id="ld-num" aria-hidden="true">0</span>}
    <span class="mono" id="ld-log">{steps[0]}</span>
  </div>
</div>

<style>
  #loader, .ld-ui { display: none; }
  :global(html.intro) #loader { display: block; position: fixed; inset: 0; z-index: 88; background: #E6E6E6; }
  :global(html.intro) .ld-ui { display: grid; position: fixed; inset: 0; z-index: 95; pointer-events: none; color: #fff; mix-blend-mode: difference; grid-template-rows: var(--header-h) 1fr auto; padding-top: env(safe-area-inset-top, 0px); padding-bottom: max(16px, env(safe-area-inset-bottom, 0px)); }
  .ld-ui { --fg: #fff; }
  .ld-top { display: flex; justify-content: space-between; align-items: center; }
  .ld-brand { font-family: var(--font-display); font-weight: 800; font-stretch: 87.5%; font-size: 20px; text-transform: uppercase; }
  .ld-bottom { display: flex; justify-content: space-between; align-items: end; gap: 16px; }
  .ld-count { font-size: clamp(120px, 24vw, 380px); line-height: .8; font-variant-numeric: tabular-nums; }
  /* "Watch it build" callout, over the loader's ink (no blending, so the accent stays the accent): a dark card with
     the accent as a touch (its square, the key and a thin edge), not a fill. */
  .ld-build { display: none; }
  :global(html.intro) .ld-build:not([hidden]) { position: fixed; right: var(--gutter-r); bottom: max(16px, env(safe-area-inset-bottom, 0px)); z-index: 97; display: grid; justify-items: end; gap: 6px;
    padding: 12px 20px; border-radius: 16px; background: #161616; color: #fff; border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); text-decoration: none; box-shadow: 0 16px 40px -18px rgb(0 0 0 / .5); transition: border-color .3s;
    animation: ld-in .6s .4s cubic-bezier(.2, .7, .1, 1) both; }
  .ld-build:hover { border-color: var(--accent); }
  .ld-build-t { font-size: 15px; display: inline-flex; gap: 8px; align-items: center; }
  .ld-build-t::before { content: ""; width: 8px; height: 8px; background: var(--accent); }
  .ld-build kbd { color: var(--accent); font-weight: 700; }
  .ld-build-w { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
  @keyframes ld-in { from { opacity: 0; transform: translateY(10px); } }
  /* It takes the place of the loading-step text in the bottom-right corner. */
  :global(html.ld-callout) #ld-log { visibility: hidden; }
  /* Console style: a terminal line across the middle of the screen with a solid block cursor. */
  .ld-term { display: none; }
  :global(html.intro) .ld-term { display: grid; align-content: center; gap: 20px; position: fixed; inset: 0; z-index: 89; pointer-events: none; color: #0B0B0B; }
  /* One line, sized so the whole welcome (prompt + text + cursor, --len characters) fits across the screen. */
  .ld-line { margin: 0; font-family: var(--font-mono); font-weight: 500; white-space: nowrap; font-size: min(92px, 5.4vw, calc((100vw - var(--gutter) - var(--gutter-r)) / (var(--len, 30) * .68))); line-height: 1.1; letter-spacing: -.02em; }
  .ld-prompt { margin-right: .5em; opacity: .45; }
  .ld-caret { display: inline-block; width: .58em; height: .95em; margin-left: .06em; vertical-align: -.12em; background: var(--accent); }
  .ld-caret.blink { animation: ld-blink 1s steps(1) infinite; }
  @keyframes ld-blink { 50% { opacity: 0; } }
  .ld-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-family: var(--font-mono); font-size: 13px; letter-spacing: .06em; min-height: 6em; }
  .ld-steps :global(li)::before { content: "[ok] "; opacity: .5; }
  .ld-console #ld-log { opacity: .6; }
  /* The loader text inverts what's under it, which would turn the ink's accent rim green. During the intro the screen
     is only greys and that rim, so a full-screen layer in mix-blend-mode: hue gives anything coloured the accent's
     hue back, and leaves the greys alone (the same fix as the header's). */
  .ld-hue { display: none; }
  :global(html.intro) .ld-hue { display: block; position: fixed; inset: 0; z-index: 96; pointer-events: none; background: var(--accent); mix-blend-mode: hue; }
  @media (forced-colors: active) { .ld-hue { display: none !important; } }
  .ld-skip { pointer-events: auto; background: none; color: inherit; border: 1.5px solid currentColor; border-radius: 999px; padding: 6px 14px; cursor: pointer; }
</style>
