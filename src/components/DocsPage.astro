---
/* One page of the site's documentation, with every page listed on the left in its folder:
     docs/README.md          → /docs/            (the docs home)
     docs/<folder>/<page>.md → /docs/<folder>/<page>/
     README.md               → /docs/overview/   (the repository's own readme)
   The brand kit (/docs/brand/) is listed with them. Like the brand kit it's an internal reference: not in the
   sitemap, not indexed. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import { t, href, type Lang } from '../lib/i18n';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const titleOf = (d: CollectionEntry<'docs'>) => d.body?.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? d.id;
const all = await getCollection('docs');
const entry = all.find((d) => d.id === slug)!;
const { Content, headings } = await render(entry);

// Folders in the order they're listed, with their names; any other folder follows, named after itself.
const GROUPS: [string, string][] = [['', 'Start'], ['writing', 'Writing'], ['home-page', 'Home page'], ['site', 'Running the site']];
const folderOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '');
const folders = [...GROUPS.map(([f]) => f), ...[...new Set(all.map((d) => folderOf(d.id)))].filter((f) => !GROUPS.some(([g]) => g === f)).sort()];
const nameOf = (f: string) => GROUPS.find(([g]) => g === f)?.[1] ?? f.replace(/-/g, ' ').replace(/^\w/, (c) => c.toUpperCase());
const urlOf = (id: string) => href(lang, id === 'index' ? 'docs' : `docs/${id}`);
const START_ORDER = ['index', 'overview'];
type Item = { label: string; url: string; current: boolean };
const groups = folders.map((f) => {
  const pages = all.filter((d) => folderOf(d.id) === f)
    .sort((a, b) => (f === '' ? START_ORDER.indexOf(a.id) - START_ORDER.indexOf(b.id) : titleOf(a).localeCompare(titleOf(b))));
  const items: Item[] = pages.map((d) => ({ label: d.id === 'index' ? 'Docs home' : d.id === 'overview' ? 'Repository readme' : titleOf(d), url: urlOf(d.id), current: d === entry }));
  if (f === '') items.push({ label: t(lang, 'nav.brand'), url: href(lang, 'brand'), current: false });
  return { name: nameOf(f), items };
}).filter((g) => g.items.length);
const source = entry.id === 'overview' ? 'README.md' : entry.id === 'index' ? 'docs/README.md' : `docs/${entry.id}.md`;
const h2s = headings.filter((h) => h.depth === 2);
---
<Base lang={lang} page="docs" title={`${t(lang, 'nav.docs')}: ${titleOf(entry)}`} description="How this site is put together and how to change it." noindex>
  <div class="wrap">
    <PageHead title={t(lang, 'nav.docs')} metaLeft="Documentation" metaRight={String(all.length + 1).padStart(2, '0')} compact>
      <p class="mono muted docs-note">Every guide for running and editing this site, and the <a class="link" href={href(lang, 'brand')}>brand kit</a> for how it looks.</p>
    </PageHead>
    <div class="docs">
      <nav aria-label={t(lang, 'nav.docs')}>
        {groups.map((g) => (
          <div class="docs-group">
            <p class="mono docs-group-name">{g.name}</p>
            <ul>{g.items.map((i) => <li><a href={i.url} aria-current={i.current ? 'page' : undefined}>{i.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
      <article class="prose-site docs-prose">
        <p class="mono muted docs-src">{source}</p>
        <h2 class="docs-title">{titleOf(entry)}</h2>
        {h2s.length >= 3 && <ol class="docs-toc">{h2s.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>}
        <Content />
      </article>
    </div>
  </div>
</Base>

<style>
  .docs-note { margin: 0; text-transform: none; letter-spacing: .04em; font-size: 13px; }
  .docs { display: grid; grid-template-columns: minmax(0, 250px) minmax(0, 1fr); gap: 48px; padding-block: 48px 112px; }
  nav { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; max-height: calc(100svh - var(--header-h) - 48px); overflow-y: auto; display: grid; gap: 28px; }
  .docs-group-name { margin: 0 0 6px; color: var(--fg); }
  .docs-group-name::before { content: "■ "; color: var(--accent); }
  nav ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  nav a { display: block; padding: 9px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 15px; line-height: 1.3; color: var(--muted); transition: color .2s; }
  nav a:hover, nav a[aria-current="page"] { color: var(--fg); }
  nav a[aria-current="page"] { font-weight: 600; }
  .docs-prose { max-width: 78ch; min-width: 0; }
  .docs-src { margin: 0 0 12px; text-transform: none; letter-spacing: .04em; }
  .docs-title { margin-top: 0 !important; font-size: clamp(34px, 4vw, 56px) !important; }
  .docs-toc { margin: 0 0 32px; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .docs-toc a { display: inline-block; border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; font-size: 13px; background: none; color: var(--fg); }
  .docs-toc a:hover { border-color: var(--fg); }
  .docs-prose :global(:is(h2, h3, h4)) { scroll-margin-top: calc(var(--header-h) + 24px); }
  .docs-prose :global(h3) { color: var(--fg); }
  .docs-prose :global(.h-anchor) { margin-left: .3em; text-decoration: none; background: none; color: var(--accent); opacity: 0; transition: opacity .2s; }
  .docs-prose :global(.has-anchor:hover .h-anchor), .docs-prose :global(.has-anchor:target .h-anchor) { opacity: 1; }
  .docs-prose :global(li) { margin-bottom: 4px; }
  .docs-prose :global(:not(pre) > code) { background: color-mix(in srgb, var(--fg) 8%, transparent); padding: .1em .35em; border-radius: 4px; color: var(--fg); }
  .docs-prose :global(pre) { margin: 16px 0 24px; padding: 16px 18px; border-radius: 6px; overflow-x: auto; font-size: 13.5px; line-height: 1.6; }
  .docs-prose :global(td code) { white-space: nowrap; }
  @media (max-width: 760px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    nav { position: static; max-height: none; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  }
</style>
