---
/* The docs sidebar: every docs page in its folder, plus the brand kit and the GitHub profile preview under Start.
   Used on every docs page, the brand kit and the preview (through DocsShell). `current` is the open page's address. */
import { getCollection, type CollectionEntry } from 'astro:content';
import { t, href, type Lang } from '../../lib/i18n';

interface Props { lang: Lang; current: string }
const { lang, current } = Astro.props;
const all = await getCollection('docs');
const titleOf = (d: CollectionEntry<'docs'>) => d.body?.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? d.id;

// Folders in the order they're listed, with their names; any other folder follows, named after itself.
const GROUPS: [string, string][] = [['', 'Start'], ['writing', 'Writing'], ['home-page', 'Home page'], ['site', 'Running the site']];
const folderOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '');
const folders = [...GROUPS.map(([f]) => f), ...[...new Set(all.map((d) => folderOf(d.id)))].filter((f) => !GROUPS.some(([g]) => g === f)).sort()];
const nameOf = (f: string) => GROUPS.find(([g]) => g === f)?.[1] ?? f.replace(/-/g, ' ').replace(/^\w/, (c) => c.toUpperCase());
const urlOf = (id: string) => href(lang, id === 'index' ? 'docs' : `docs/${id}`);
const START_ORDER = ['index', 'overview'];
const groups = folders.map((f) => {
  const pages = all.filter((d) => folderOf(d.id) === f)
    .sort((a, b) => (f === '' ? START_ORDER.indexOf(a.id) - START_ORDER.indexOf(b.id) : titleOf(a).localeCompare(titleOf(b))));
  const items = pages.map((d) => ({ label: d.id === 'index' ? 'Docs home' : d.id === 'overview' ? 'Repository readme' : titleOf(d), url: urlOf(d.id) }));
  if (f === '') items.push({ label: t(lang, 'nav.brand'), url: href(lang, 'brand') }, { label: 'GitHub profile preview', url: href(lang, 'docs/github-preview') });
  return { name: nameOf(f), items };
}).filter((g) => g.items.length);
---
<nav class="docs-nav" aria-label={t(lang, 'nav.docs')}>
  {groups.map((g) => (
    <div class="docs-group">
      <p class="mono docs-group-name">{g.name}</p>
      <ul>{g.items.map((i) => <li><a href={i.url} aria-current={i.url === current ? 'page' : undefined}>{i.label}</a></li>)}</ul>
    </div>
  ))}
</nav>

<style>
  .docs-nav { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; max-height: calc(100svh - var(--header-h) - 48px); overflow-y: auto; display: grid; gap: 28px; }
  .docs-group-name { margin: 0 0 6px; color: var(--fg); }
  .docs-group-name::before { content: "■ "; color: var(--accent); }
  ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  a { display: block; padding: 9px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 15px; line-height: 1.3; color: var(--muted); transition: color .2s; }
  a:hover, a[aria-current="page"] { color: var(--fg); }
  a[aria-current="page"] { font-weight: 600; }
  @media (max-width: 760px) {
    .docs-nav { position: static; max-height: none; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  }
</style>
