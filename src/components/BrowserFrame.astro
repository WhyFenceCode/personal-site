---
/* A browser window around a project's screenshot. When the live site allows framing, "Load live site" swaps in
   the real site (rendered at desktop width and scaled to fit), so it's interactive right on the page.
   Nothing from the other site loads until that click. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; title: string; live?: string; cover?: ImageMetadata; art: string; interactive: boolean }
const { lang, title, live, cover, art, interactive } = Astro.props;
const host = live ? new URL(live).host : '';
---
<figure class="frame" data-frame>
  <div class="bar" aria-hidden={live ? undefined : 'true'}>
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {live && <span class="url mono"><i aria-hidden="true"></i>{host}</span>}
    <span class="bar-end">
      {live && interactive && <span class="mono muted state" data-state data-live={t(lang, 'work.preview.on')}>{t(lang, 'work.preview.screenshot')}</span>}
    </span>
  </div>
  <div class="view" data-view>
    {cover
      ? <Image src={cover} alt={live ? `${t(lang, 'work.preview.alt')} ${host}` : ''} widths={[800, 1440, 2000]} sizes="(max-width: 1600px) 100vw, 1600px" class="shot" loading="eager" />
      : <canvas width="1280" height="800" data-art={art} aria-hidden="true"></canvas>}
    {live && interactive && (
      <button type="button" class="load" data-load={live} data-title={`${title}: ${t(lang, 'work.preview.live')}`}>
        <span class="sq" aria-hidden="true"></span>{t(lang, 'work.preview.load')}
        <span class="sub">{t(lang, 'work.preview.note', { host })}</span>
      </button>
    )}
  </div>
</figure>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-frame]').forEach((frame) => {
      const btn = frame.querySelector<HTMLButtonElement>('[data-load]'); if (!btn) return;
      const view = frame.querySelector<HTMLElement>('[data-view]')!, state = frame.querySelector<HTMLElement>('[data-state]');
      btn.addEventListener('click', () => {
        const W = 1440;
        const iframe = document.createElement('iframe');
        iframe.src = btn.dataset.load!;
        iframe.title = btn.dataset.title!;
        iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox');
        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        iframe.className = 'live';
        // Render at desktop width and scale down, so the site shows its real desktop layout.
        const fit = () => {
          const k = view.clientWidth / W;
          iframe.style.width = `${W}px`; iframe.style.height = `${view.clientHeight / k}px`; iframe.style.transform = `scale(${k})`;
        };
        view.appendChild(iframe); fit();
        new ResizeObserver(fit).observe(view);
        frame.classList.add('is-live');
        if (state) state.textContent = state.dataset.live ?? 'Live';
        btn.remove();
        iframe.focus();
      });
    });
  });
</script>

<style>
  .frame { margin: 0; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--bg); }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .url { display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border: 1px solid var(--line); border-radius: 999px; text-transform: none; letter-spacing: .04em; font-size: 12px; }
  .url i { width: 6px; height: 6px; border-radius: 50%; background: var(--fg); }
  .bar-end { justify-self: end; }
  .state { font-size: 11px; }
  .view { position: relative; aspect-ratio: 16 / 10; max-width: 100%; overflow: hidden; background: #EDEDED; }
  .view :global(.shot), .view canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .view :global(.live) { position: absolute; left: 0; top: 0; border: 0; transform-origin: 0 0; background: #fff; }
  .load { position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%); display: grid; justify-items: center; gap: 4px; padding: 14px 22px; border: 0; border-radius: 12px; background: var(--fg); color: var(--bg); cursor: pointer;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; box-shadow: 0 16px 40px -16px rgb(0 0 0 / .5); }
  .load .sq { display: none; }
  .load .sub { text-transform: none; letter-spacing: .02em; font-size: 11px; opacity: .7; }
  .load:hover { transform: translateX(-50%) translateY(-2px); }
  @media (max-width: 640px) { .bar { grid-template-columns: auto 1fr; } .bar-end { display: none; } .url { justify-self: end; } .load { bottom: 12px; padding: 10px 14px; } }
</style>
