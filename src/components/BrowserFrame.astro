---
/* The browser window at the top of a project page: the live site when it allows being framed (after Continue for
   outside sites), else its screenshot, else placeholder art. The same frame appears in Markdown via ::site{…};
   both come from src/lib/frame.mjs. On phones the window is portrait and uses the tablet screenshot
   (<slug>-tablet.jpg from `pnpm shots`) when there is one. */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { frameHtml } from '../lib/frame.mjs';
import { t, type Lang } from '../lib/i18n';
import { site } from '../lib/config';

interface Props { lang: Lang; title: string; live?: string; cover?: ImageMetadata; tablet?: ImageMetadata; art: string; interactive: boolean; devBlocked?: boolean }
const { lang, title, live, cover, tablet, art, interactive, devBlocked = false } = Astro.props;
const host = live ? new URL(live).host : '';
let image = '';
if (cover && !(live && interactive)) {
  const main = await getImage({ src: cover, widths: [800, 1440, 2000], sizes: '(max-width: 1600px) 100vw, 1600px', format: 'webp' });
  const tab = tablet ? await getImage({ src: tablet, width: 900, format: 'webp' }) : null;
  const alt = live ? `${t(lang, 'projects.preview.alt')} ${host}` : '';
  image = `<picture>${tab ? `<source media="(max-width: 700px)" srcset="${tab.src}">` : ''}<img src="${main.src}" srcset="${main.srcSet.attribute}" sizes="(max-width: 1600px) 100vw, 1600px" width="${cover.width}" height="${cover.height}" alt="${alt}" loading="eager" decoding="async"></picture>`;
}
const devNote = devBlocked
  ? `<p class="bf-dev-note mono">Dev only: ${host} doesn't allow <code>${Astro.url.origin}</code> to frame it, so your browser blocks it here.
      It will load on ${new URL(Astro.site ?? site.url).host}. To see it locally, add ${Astro.url.origin} to that site's <code>frame-ancestors</code>.</p>`
  : '';
const html = frameHtml({ url: live, title, siteUrl: site.url, interactive, image, art, devNote, lang });
---
<Fragment set:html={html} />
