---
/* Shared frame for every home section: tone band, eyebrow, big title and a CTA to a deeper page. */
import { t, href, type Lang } from '../../lib/i18n';
import type { Cta } from '../../lib/config';

interface Props { lang: Lang; id: string; tone: 'light' | 'dark'; eyebrow: string; title: string; count?: string | number; cta?: Cta; note?: string }
const { lang, id, tone, eyebrow, title, count, cta, note } = Astro.props;
const external = cta && /^https?:/.test(cta.to);
---
<section class:list={['home-section', `tone-${tone}`]} id={id} aria-labelledby={`${id}-title`}>
  <div class="section wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow mono">{eyebrow}</div>
        <h2 class="h2" id={`${id}-title`}>{title}{count !== undefined && <span class="count">({count})</span>}</h2>
      </div>
      {note && <p class="mono muted sec-note">{note}</p>}
    </div>
    <slot />
    {cta && (
      <div class="sec-cta">
        <a class="sec-cta-link" href={href(lang, cta.to)} rel={external ? 'noopener' : undefined}>
          <span>{t(lang, cta.label)}</span>
          <span class="sec-cta-arrow" aria-hidden="true"><svg width="28" height="16" viewBox="0 0 28 16"><path d="M0 8h25M18 1l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .sec-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 24px; margin-bottom: clamp(32px, 4vw, 56px); }
  .sec-head .eyebrow { margin-bottom: 18px; }
  .sec-note { max-width: 32ch; text-align: right; margin: 0; }
  .sec-cta { margin-top: clamp(32px, 4vw, 56px); display: flex; justify-content: flex-end; }
  .sec-cta-link { display: inline-flex; align-items: center; gap: 18px; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-stretch: 85%; text-transform: uppercase; font-size: clamp(22px, 2.6vw, 34px); letter-spacing: -.01em; border-bottom: 2px solid currentColor; padding-bottom: 6px; }
  .sec-cta-arrow { display: inline-grid; place-items: center; transition: transform .5s var(--ease); }
  .sec-cta-link:hover .sec-cta-arrow, .sec-cta-link:focus-visible .sec-cta-arrow { transform: translateX(8px); }
  @media (max-width: 760px) { .sec-head { grid-template-columns: minmax(0, 1fr); } .sec-note { text-align: left; } .sec-cta { justify-content: flex-start; } }
</style>
