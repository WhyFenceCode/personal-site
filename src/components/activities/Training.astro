---
/* Running or cycling: weekly distance for the last 26 weeks. Only rendered when there was recent activity. */
import Tile from './Tile.astro';
import { t, type Lang } from '../../lib/i18n';
import type { Sport, Stats } from '../../lib/strava';
interface Props { lang: Lang; size: 1 | 2 | 4; sport: Sport; data: Stats }
const { lang, size, sport, data } = Astro.props;
const { weeks, unit } = data;
const max = Math.max(...weeks, 1);
const W = 400, H = 120, bw = W / Math.max(1, weeks.length);
const fmt = (n: number) => n.toLocaleString(lang);
---
<Tile title={t(lang, `activities.${sport}.title`)} meta={data.goal ? t(lang, 'activities.training.goal', { goal: fmt(data.goal), unit }) : undefined} size={size}>
  <figure class="run" data-run data-unit={unit}>
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${fmt(data.total)} ${unit} over ${weeks.length} weeks, best week ${max} ${unit}`}>
      {weeks.map((v, i) => <rect x={i * bw + 1.5} y={H - (v / max) * (H - 6)} width={bw - 3} height={Math.max(1, (v / max) * (H - 6))} data-v={v} data-w={weeks.length - i} />)}
    </svg>
    <figcaption class="mono muted" aria-hidden="true" data-run-read>{t(lang, 'activities.training.hover')}</figcaption>
  </figure>
  <div class="stats">
    <div><span class="stat big">{fmt(data.total)}</span><span class="mono muted">{t(lang, 'activities.training.total', { unit })}</span></div>
    {data.longest && <div><span class="stat big">{data.longest.km}</span><span class="mono muted">{t(lang, 'activities.training.longest')}{data.longest.name && ` · ${data.longest.name}`}</span></div>}
  </div>
  {data.source === 'strava' && <p class="mono muted attr">Data from Strava</p>}
</Tile>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-run]').forEach((fig) => {
      const read = fig.querySelector<HTMLElement>('[data-run-read]')!;
      fig.addEventListener('pointerover', (e) => {
        const r = (e.target as Element).closest<SVGRectElement>('rect'); if (!r) return;
        fig.querySelectorAll('rect').forEach((x) => x.classList.toggle('on', x === r));
        const w = Number(r.dataset.w);
        read.textContent = `${r.dataset.v} ${fig.dataset.unit} · ${w === 1 ? 'this week' : `${w - 1} weeks ago`}`;
      });
    });
  });
</script>

<style>
  .run { margin: 0; }
  svg { width: 100%; height: 120px; display: block; }
  rect { fill: var(--fg); opacity: .35; transition: opacity .2s; }
  rect:hover, rect:global(.on) { opacity: 1; }
  figcaption { margin-top: 8px; text-transform: none; letter-spacing: .04em; }
  .stats { display: flex; gap: 32px; flex-wrap: wrap; }
  .stats > div { display: grid; gap: 4px; }
  .big { font-size: 44px; line-height: 1; }
  .attr { margin: 0; font-size: 10px; }
</style>
