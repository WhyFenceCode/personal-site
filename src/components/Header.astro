---
import LangSwitch from './LangSwitch.astro';
import { site } from '../lib/config';
import { t, href, type Lang } from '../lib/i18n';

interface Props { lang: Lang; page: string }
const { lang, page } = Astro.props;
const nav = [
  { key: 'projects', label: t(lang, 'nav.projects') },
  { key: 'blog', label: t(lang, 'nav.blog') },
  { key: 'resume', label: t(lang, 'nav.resume') },
  { key: 'about', label: t(lang, 'nav.about') },
];
---
<header class="site-header wrap">
  <a class="brand" href={href(lang, 'home')}>{site.name}{site.theme.logoDot && <span class="brand-gap" aria-hidden="true">.</span>}</a>
  <nav class="hnav" aria-label="Main">
    {nav.map((n) => (
      <a href={href(lang, n.key)} class:list={['hnav-link', { 'is-resume': n.key === 'resume' }]} aria-current={page === n.key ? 'page' : undefined}>
        {n.key === 'resume' && <span class="sq" aria-hidden="true"></span>}{n.label}
      </a>
    ))}
    <a href={href(lang, 'contact')} class="hnav-link is-contact">{t(lang, 'nav.contact')}<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 10L10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a>
  </nav>
  <button class="menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="menu">
    <span>{t(lang, 'nav.menu')}</span><span class="grip" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </button>
</header>
{/* The header inverts against the page (mix-blend-mode: difference), which would invert the accent too, so the
    full stop is drawn outside it, over the invisible placeholder in the brand. Positioned by site.ts. */}
{site.theme.logoDot && <span class="brand-dot" aria-hidden="true" data-brand-dot>.</span>}

<div class="menu tone-dark wrap" id="menu" role="dialog" aria-modal="true" aria-label={t(lang, 'nav.menu')} hidden>
  <div class="menu-top">
    <span class="brand">{site.name}{site.theme.logoDot && <span class="dot" aria-hidden="true">.</span>}</span>
    <button class="menu-btn" type="button" id="menu-close"><span>{t(lang, 'nav.close')}</span><span class="grip" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button>
  </div>
  <nav aria-label="Menu"><ul>
    {[{ key: 'home', label: t(lang, 'nav.home') }, ...nav, { key: 'contact', label: t(lang, 'nav.contact') }].map((n, i) => (
      <li><a href={href(lang, n.key)} aria-current={page === n.key ? 'page' : undefined}><span>{n.label}</span><sup>{String(i + 1).padStart(2, '0')}</sup></a></li>
    ))}
  </ul></nav>
  <div class="menu-foot mono"><span>{site.email}</span><LangSwitch lang={lang} /></div>
</div>

<style>
  /* --hw / --hk: the header's white and black. The hue layer below swaps both for the accent. */
  .site-header { --hw: #fff; --hk: #000; position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--hw); mix-blend-mode: difference; pointer-events: none; }
  /* Inverting turns the accent (purple) into its opposite (green) wherever it passes under the header. A copy of the
     header's shapes sits right on top in the accent with mix-blend-mode: hue, which keeps each pixel's brightness
     and saturation but gives it the accent's hue: the green goes back to purple, and greys (no saturation) stay
     exactly as they were. Made by the script below; it mirrors the real header's hover and current-page states. */
  .site-header.hdr-hue { --hw: var(--accent); --hk: var(--accent); mix-blend-mode: hue; margin-top: calc(-1 * var(--header-h)); }
  .site-header.hdr-hue, .site-header.hdr-hue * { pointer-events: none !important; }
  @media (forced-colors: active) { .hdr-hue { display: none !important; } }
  .site-header > * { pointer-events: auto; }
  .brand-gap { visibility: hidden; }
  .brand .dot { color: var(--accent); }
  .brand-dot { position: fixed; left: 0; top: 0; z-index: 51; pointer-events: none; color: var(--accent); font-family: var(--font-display); font-weight: 800; font-stretch: 87.5%; font-size: 20px; letter-spacing: -.01em; opacity: 0; }
  .brand { font-family: var(--font-display); font-weight: 800; font-stretch: 87.5%; font-size: 20px; letter-spacing: -.01em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .hnav { display: flex; align-items: center; gap: 6px; }
  .hnav-link { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; padding: 9px 14px; border-radius: 999px; transition: background .3s, color .3s; }
  .hnav-link:hover, .hnav-link[data-hover], .hnav-link[aria-current="page"] { background: var(--hw); color: var(--hk); }
  .hnav-link.is-resume { box-shadow: inset 0 0 0 1.5px var(--hw); }
  .hnav-link .sq { width: 7px; height: 7px; background: currentColor; }
  .hnav-link.is-contact { background: var(--hw); color: var(--hk); margin-left: 6px; }
  .hnav-link.is-contact:is(:hover, [data-hover]) { background: none; color: var(--hw); box-shadow: inset 0 0 0 1.5px var(--hw); }
  .menu-btn { display: none; align-items: center; gap: 10px; background: none; border: 0; padding: 10px 0; cursor: pointer; font-family: var(--font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: inherit; }
  .menu-btn .grip { display: grid; grid-template-columns: 3px 3px; gap: 3px; }
  .menu-btn .grip i { width: 3px; height: 3px; background: currentColor; }
  @media (max-width: 860px) { .hnav { display: none; } .site-header .menu-btn { display: inline-flex; } }

  .menu { position: fixed; inset: 0; z-index: 70; display: grid; grid-template-rows: var(--header-h) 1fr auto; padding-top: env(safe-area-inset-top, 0px); padding-bottom: max(24px, env(safe-area-inset-bottom, 0px)); clip-path: circle(0 at var(--mx, 95%) var(--my, 32px)); transition: clip-path .8s var(--ease); }
  .menu:global(.open) { clip-path: circle(150% at var(--mx, 95%) var(--my, 32px)); }
  .menu-top { display: flex; justify-content: space-between; align-items: center; }
  .menu .menu-btn { display: inline-flex; }
  .menu ul { list-style: none; margin: 0; padding: 0; align-self: center; display: grid; }
  .menu li a { display: flex; align-items: baseline; gap: 14px; text-decoration: none; font-family: var(--font-display); font-weight: 800; font-stretch: 87.5%; text-transform: uppercase; letter-spacing: -.02em; line-height: .92; font-size: clamp(52px, 13vw, 150px); transition: opacity .3s, transform .5s var(--ease); }
  .menu li a sup { font-family: var(--font-mono); font-size: 13px; letter-spacing: .1em; }
  /* Hover effects only where there's a real hover: on touchscreens they'd turn the first tap into a hover. */
  @media (hover: hover) { .menu ul:hover a { opacity: .3; } }
  @media (hover: hover) { .menu ul a:hover, .menu ul a:focus-visible { opacity: 1; transform: translateX(12px); } }
  .menu li a[aria-current="page"]::after { content: ""; width: .14em; height: .14em; background: currentColor; align-self: center; }
  .menu-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
</style>

<script>
  // The hue layer (see the CSS above): a copy of the header right after it, kept in step with it.
  document.addEventListener('astro:page-load', () => {
    const real = document.querySelector<HTMLElement>('.site-header:not(.hdr-hue)'); if (!real) return;
    document.querySelectorAll('.hdr-hue').forEach((e) => e.remove());
    const copy = real.cloneNode(true) as HTMLElement;
    copy.classList.add('hdr-hue');
    copy.setAttribute('aria-hidden', 'true'); copy.inert = true;
    copy.querySelectorAll('[id]').forEach((e) => e.removeAttribute('id'));
    real.after(copy);
    const realEls = [...real.querySelectorAll<HTMLElement>('*')], copyEls = [...copy.querySelectorAll<HTMLElement>('*')];
    // :hover can't be copied, so the real links mark themselves with data-hover while the pointer is on them.
    real.querySelectorAll('.hnav-link').forEach((a) => {
      a.addEventListener('pointerenter', () => a.setAttribute('data-hover', ''));
      a.addEventListener('pointerleave', () => a.removeAttribute('data-hover'));
    });
    // Mirror every change to the real header: hover marks, the current page, the magnetic button's inline transform.
    const mo = new MutationObserver((list) => {
      for (const m of list) {
        const i = realEls.indexOf(m.target as HTMLElement), el = m.target === real ? copy : copyEls[i];
        if (!el || !m.attributeName) continue;
        const v = (m.target as HTMLElement).getAttribute(m.attributeName);
        if (m.target === real && m.attributeName === 'class') { el.className = `${v ?? ''} hdr-hue`; continue; }
        v === null ? el.removeAttribute(m.attributeName) : el.setAttribute(m.attributeName, v);
      }
    });
    mo.observe(real, { attributes: true, subtree: true, attributeFilter: ['class', 'style', 'aria-current', 'data-hover', 'hidden'] });
    document.addEventListener('astro:before-swap', () => mo.disconnect(), { once: true });
  });
</script>
