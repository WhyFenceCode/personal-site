---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource-variable/pixelify-sans/wght.css'; // only used by the hero's pixel layer
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Banner from '../components/Banner.astro';
import { existsSync } from 'node:fs';
import { site } from '../lib/config';
import { analyticsScript } from '../lib/analytics';
import { languages, t, switchPath, type Lang } from '../lib/i18n';

interface Props { lang: Lang; title?: string; description?: string; page?: string; noindex?: boolean }
const { lang, title, description, page = '', noindex = false } = Astro.props;
const fullTitle = `${site.name} | ${title ?? t(lang, 'nav.home')}`;
const desc = description ?? t(lang, 'meta.description');
const analytics = analyticsScript();
const needsConsent = !!analytics && site.analytics.consent;
const showBanner = site.banner.enabled && (site.banner.pages === 'all' || page === 'home');
const portraitOk = site.portrait.enabled && existsSync(`public${site.portrait.src}`);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---
<!doctype html>
<html lang={lang} data-page={page} data-numbers={site.typography.numbers} data-headings={site.typography.headings} data-echo={String(site.theme.headingEcho)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {/* Index and show in search, but don't train on it (noai/noimageai and TDMRep; robots.txt says the same). */}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, noai, noimageai'} />
    <meta name="tdm-reservation" content="1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" title="llms.txt" href="/llms.txt" />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchPath(Astro.url.pathname, l), Astro.site ?? site.url).href} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {portraitOk && <meta property="og:image" content={new URL(site.portrait.src, Astro.site ?? site.url).href} />}
    <meta name="theme-color" content="#161616" />
    <style is:inline set:html={`:root{--accent:${site.theme.accent}}`} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Decide before first paint. The intro plays on every fresh open of the site (a new tab, a typed URL, a
      // reload), but not when moving between pages inside it; reduced motion skips it. The flag lives on
      // window, which survives in-site navigation but not a fresh load.
      try {
        var d = document.documentElement;
        if (localStorage.getItem('site.motion') === 'off') d.classList.add('no-motion');
        if (!window.__siteOpened) {
          window.__siteOpened = true;
          localStorage.removeItem('site.banner'); sessionStorage.removeItem('site.seen'); // no longer used
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !d.classList.contains('no-motion')) d.classList.add('intro');
        }
        if (window.__bannerClosed) d.classList.add('banner-hidden');
        // A reload starts at the top (or at its #anchor), not back where the page was: the browser would restore the
        // old position, and so would the router (from history.state, before its first paint), so both are told not to.
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'reload') {
          history.scrollRestoration = 'manual';
          if (history.state) history.replaceState(Object.assign({}, history.state, { scrollX: 0, scrollY: 0 }), '');
        }
        // /build: hide the page before first paint; the cursors build it in (scripts/build.ts).
        if (d.dataset.page === 'build' && !d.classList.contains('no-motion') && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('building');
      } catch (e) {}
    </script>
    <noscript>
      {/* Without JavaScript (crawlers, script blockers): size the wordmarks with CSS instead of measuring them,
          open the collapsible rows, show the main nav on phones, and hide controls that only work with scripts. */}
      <style is:inline>
        .fit { font-size: clamp(40px, 9vw, 168px) !important; white-space: normal !important; }
        .hero-line.line-full, .foot-mark .fit { font-size: 15vw !important; }
        .hero-line.line-word { font-size: 25vw !important; }
        .page-title .fit { font-size: 18vw !important; }
        .row-panel { grid-template-rows: 1fr !important; } .row-btn .pm { display: none !important; }
        .smooth { opacity: 1 !important; }
        @media (max-width: 860px) {
          .site-header .hnav { display: flex !important; gap: 0 !important; }
          .site-header .hnav-link { padding: 6px 5px !important; font-size: 10px !important; letter-spacing: .06em !important; box-shadow: none !important; }
          .site-header .hnav-link .sq, .site-header .hnav-link.is-contact { display: none !important; }
        }
        .menu-btn, #progress, #ring, #flood, .hero-hint, .dive-meter, .layer-label, .hero-side time,
        [data-layer-next], [data-motion-toggle], [data-banner-close], [data-copy],
        [data-gh-3d], [data-marquee-pause], [data-filter], [data-open-cookies] { display: none !important; }
      </style>
    </noscript>
    {analytics && !needsConsent && <script is:inline defer src={analytics.src} {...analytics.attrs}></script>}
    <ClientRouter fallback="none" />
  </head>
  <body
    data-transitions={String(site.features.pageTransitions)}
    data-ring={String(site.features.cursorRing)}
    data-accent-cursor={String(site.theme.accentCursor)}
    data-home-title={`${site.name} | ${t(lang, 'nav.home')}`}
    data-ix={Object.entries(site.interactive).filter(([, on]) => on).map(([k]) => k).join(' ')}
    data-loader={String(site.features.loader)}
  >
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    {site.features.loader && <Loader lang={lang} />}
    <canvas id="flood" aria-hidden="true" transition:persist></canvas>
    <div id="ring" aria-hidden="true" transition:persist></div>
    <button type="button" id="progress" aria-label={t(lang, 'nav.top')} transition:persist>
      <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17" pathLength="1" /></svg>
    </button>
    <div class="sr-only" aria-live="polite" id="announcer" transition:persist></div>
    {site.interactive.sheen && <div id="sheen" aria-hidden="true" transition:persist></div>}
    {site.interactive.build && page === 'home' && (
      <a class="build-hint mono" href={`/${lang}/build/`} data-build-hint data-astro-reload>
        <svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1v11l3-3 2 4.5 2-1-2-4.4H10z" fill="currentColor"/></svg>
        <span>{t(lang, 'build.hint')}</span> <kbd>⇧ B</kbd> <span class="build-hint-w">· {t(lang, 'build.motion')}</span>
      </a>
    )}
    <div id="peek" aria-hidden="true" transition:persist><canvas width="300" height="225"></canvas><img alt="" hidden /></div>
    {showBanner && <Banner lang={lang} />}
    <script is:inline>
      // The hero fills the first screen minus the banner; keep --banner-h in sync (0 when hidden or dismissed).
      (function () {
        var r = document.documentElement, b = document.querySelector('[data-banner]');
        function set() { r.style.setProperty('--banner-h', (b && b.offsetParent !== null ? b.offsetHeight : 0) + 'px'); }
        set();
        if (b && window.ResizeObserver) new ResizeObserver(set).observe(b);
      })();
    </script>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    {needsConsent && <CookieBanner lang={lang} />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  .skip-link { position: fixed; left: 16px; top: -60px; z-index: 200; background: #0B0B0B; color: #fff; padding: 10px 16px; border-radius: 999px; text-decoration: none; }
  .skip-link:focus { top: calc(12px + env(safe-area-inset-top, 0px)); }
  #flood { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 90; pointer-events: none; }
  /* The cursor: a dot that inverts whatever is under it (black and white swap, but the accent stays the accent:
     inverting then turning the hue half way round brings a colour back to itself), growing over things you can click.
     The system cursor is hidden only for a mouse, only once the dot is tracking it, and never in high-contrast
     (forced colours) or increased-contrast modes, where the system cursor stays. */
  #ring { position: fixed; left: 0; top: 0; z-index: 120; width: 24px; height: 24px; margin: -12px 0 0 -12px; border-radius: 50%; -webkit-backdrop-filter: invert(1) hue-rotate(180deg); backdrop-filter: invert(1) hue-rotate(180deg); pointer-events: none; transform: translate3d(-100px, -100px, 0) scale(.3); opacity: 0; transition: opacity .2s; }
  html.has-ring #ring.on { opacity: 1; }
  /* Over something clickable the dot can turn solid accent (site.yaml theme.accentCursor) instead of inverting. */
  #ring.accent { background: var(--accent); -webkit-backdrop-filter: none; backdrop-filter: none; }
  @media (forced-colors: none) and (prefers-contrast: no-preference) { html.has-ring.ring-live, html.has-ring.ring-live * { cursor: none !important; } }
  @media (forced-colors: active), (prefers-contrast: more) { #ring { display: none; } }
  @media (forced-colors: active) { #flood { display: none; } }

  /* Scroll progress: a ring in the corner that draws itself clockwise from the top as you scroll. Inverts
     what's behind it the same way as the cursor (the accent stays the accent): the inverting is done to the backdrop,
     masked to the ring drawn so far (--p, set by site.ts). Clicking it goes back to the top. */
  #progress { position: fixed; right: max(18px, env(safe-area-inset-right, 0px)); bottom: max(18px, env(safe-area-inset-bottom, 0px)); z-index: 70; width: 52px; height: 52px; padding: 0; border: 0; border-radius: 50%; background: none; color: transparent; -webkit-backdrop-filter: invert(1) hue-rotate(180deg); backdrop-filter: invert(1) hue-rotate(180deg); cursor: pointer; opacity: 0; pointer-events: none; transition: opacity .4s, transform .4s var(--ease); }
  #progress { --ring: radial-gradient(circle closest-side, transparent calc(100% - 6.6px), #000 calc(100% - 6.5px), #000 calc(100% - 1.3px), transparent calc(100% - 1.2px));
    --arc: conic-gradient(#000 calc(var(--p, 0) * 1turn), transparent 0);
    -webkit-mask: var(--arc), var(--ring); -webkit-mask-composite: source-in; mask: var(--arc), var(--ring); mask-composite: intersect; }
  #progress.on { opacity: 1; pointer-events: auto; }
  #progress:hover { transform: scale(1.12); }
  #progress:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  #progress svg { width: 100%; height: 100%; transform: rotate(-90deg); overflow: visible; }
  #progress circle { fill: none; stroke: currentColor; stroke-width: 4; stroke-linecap: butt; stroke-dasharray: var(--p, 0) 1; }
  html.intro #progress { opacity: 0; }
  @media (forced-colors: active) { #progress { -webkit-backdrop-filter: none; backdrop-filter: none; -webkit-mask: none; mask: none; color: CanvasText; } }
  main { display: block; }
  #peek { position: fixed; left: 0; top: 0; width: 300px; height: 225px; z-index: 30; pointer-events: none; opacity: 0; transition: opacity .3s; overflow: hidden; border-radius: 4px; }
  #peek.on { opacity: 1; }
  #peek canvas, #peek img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: top; }
</style>
