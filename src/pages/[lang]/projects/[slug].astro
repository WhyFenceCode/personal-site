---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BrowserFrame from '../../../components/BrowserFrame.astro';
import ProjectModel from '../../../components/ProjectModel';
import RepoViewer from '../../../components/RepoViewer.astro';
import { projectsFor, slugOf } from '../../../lib/content';
import { coverFor, tabletFor, canFrame } from '../../../lib/projects';
import { site } from '../../../lib/config';
import { languages, t, href } from '../../../lib/i18n';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of languages) for (const p of await projectsFor(lang)) paths.push({ params: { lang, slug: slugOf(p.id) } });
  return paths;
}
const { lang, slug } = Astro.params as { lang: string; slug: string };
const all = await projectsFor(lang);
const i = all.findIndex((p) => slugOf(p.id) === slug);
const p = all[i], next = all[(i + 1) % all.length];
const { Content, headings } = await render(p);
const d = p.data;
// What fills the window under the title. Anything unrecognised (or missing, e.g. data cached by an older dev server)
// means the site frame, so a project never silently loses its preview.
const showcase = d.showcase === 'repo' && d.repo ? 'repo' : d.showcase === 'none' ? 'none' : 'site';
const cover = coverFor(p), tablet = tabletFor(p);
// Embed whenever the real domain is allowed to frame the site. In dev the page runs on localhost, which the
// other site may not allow; then a note says so instead of leaving an unexplained "refused to connect".
const interactive = !!d.live && d.preview && (await canFrame(d.live, site.url));
const devBlocked = import.meta.env.DEV && interactive && !(await canFrame(d.live!, Astro.url.origin));
const facts: [string, string][] = [
  [t(lang, 'projects.client'), d.client ?? ''],
  [t(lang, 'projects.year'), String(d.year)],
  [t(lang, 'projects.type'), d.kind],
  [t(lang, 'projects.services'), d.services.join(', ')],
  [t(lang, 'projects.role'), d.role],
].filter(([, v]) => v) as [string, string][];
const firstHeading = headings.find((h) => h.depth === 2)?.text;
---
<Base lang={lang} page="projects" title={d.title} description={d.summary}>
  {/* With a 3D model: the story on the left, the model small and pinned on the right while you read. */}
  <article class:list={['wrap case', { split: d.model }]}>
   <div class="case-text">
    <header class="case-head">
      <div class="crumbs mono muted"><a href={href(lang, 'projects')}>← {t(lang, 'nav.projects')}</a><span>{d.kind} {d.year}</span></div>
      <h1 class="case-title" id="page-title" tabindex="-1">{d.title}</h1>
      <div class="case-sub">
        <p class="lead">{d.summary}</p>
        {d.live && (
          <a class="visit" href={d.live} rel="noopener">
            <span>{t(lang, 'projects.visit')}</span>
            <span class="disc" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M3 11L11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
          </a>
        )}
      </div>
      {d.model && <a class="scroll-cue mono muted" href="#case-body"><span>{t(lang, 'projects.scrollCue')}</span><span class="cue-arrow" aria-hidden="true">↓</span></a>}
    </header>

    {/* The big window only for a real screenshot/cover or the live site; placeholder art alone isn't worth the space. */}
    {/* The wide window under the title (showcase in the frontmatter): the site, its repository, or nothing. The site
        frame needs a real screenshot/cover or the live site; placeholder art alone isn't worth the space. */}
    {showcase === 'site' && (cover || interactive) && <BrowserFrame lang={lang} title={d.title} live={d.live} cover={cover} tablet={tablet} art={d.art} interactive={interactive} devBlocked={devBlocked} />}
    {showcase === 'repo' && <div class="case-showcase"><RepoViewer repo={d.repo} /></div>}
    <div class="case-body" id="case-body">
      <aside class="facts">
        <dl>
          {facts.map(([k, v]) => <div><dt class="mono muted">{k}</dt><dd>{v}</dd></div>)}
          {d.stack.length > 0 && <div><dt class="mono muted">{t(lang, 'projects.technology')}</dt><dd><ul class="chips">{d.stack.map((s) => <li>{s}</li>)}</ul></dd></div>}
          {d.links.length > 0 && <div><dt class="mono muted">{t(lang, 'projects.links')}</dt><dd><ul class="links">{d.links.map((l) => <li><a class="link" href={l.url} rel="noopener">{l.label} ↗</a></li>)}</ul></dd></div>}
        </dl>
      </aside>
      <div class="main">
        {d.metrics.length > 0 && (
          <ul class="metrics">
            {d.metrics.map((m) => <li><span class="stat">{m.value}</span><span class="muted">{m.label}</span></li>)}
          </ul>
        )}
        {!firstHeading && <h2 class="overview">{t(lang, 'projects.overview')}</h2>}
        <div class="prose-site case-prose"><Content /></div>
      </div>
    </div>
   </div>
    {d.model && <div class="case-side"><ProjectModel client:visible src={d.model} title={d.title} hint={t(lang, 'projects.modelHint')} angle={d.modelAngle} fill /></div>}
  </article>

  <div class="tone-dark">
    <a class="next wrap" href={href(lang, `projects/${slugOf(next.id)}`)}>
      <span><span class="mono muted" style="display:block;margin-bottom:12px">{t(lang, 'projects.next')}</span><span class="display next-title">{next.data.title}</span></span>
      <svg width="48" height="28" viewBox="0 0 48 28" aria-hidden="true"><path d="M0 14h45M33 2l12 12-12 12" fill="none" stroke="currentColor" stroke-width="2"/></svg>
    </a>
  </div>
</Base>

<style>
  .case { padding-bottom: clamp(64px, 8vw, 120px); }
  .case :global(.model) { margin: 0; display: grid; gap: 10px; }
  .case :global(.model-stage canvas) { display: block; width: 100%; border-radius: 10px; }

  /* Split layout (projects with a model): text left, the model pinned on the right. */
  .split { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .case-side { position: sticky; top: calc(var(--header-h) + 8px); height: calc(100svh - var(--header-h) - 16px); }
  .case-side :global(.model) { height: 100%; grid-template-rows: minmax(0, 1fr) auto; }
  .case-side :global(.model-stage) { position: relative; min-height: 0; }
  .case-side :global(.model-stage canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The intro fills the first screen, with a cue at the bottom to scroll on into the story. */
  .split .case-head { min-height: calc(100svh - var(--header-h) - 24px); display: flex; flex-direction: column; padding-bottom: 32px; }
  .split .crumbs { margin-bottom: auto; padding-bottom: 32px; }
  .split .case-title { font-size: clamp(48px, 7vw, 120px); }
  .split .case-body { grid-template-columns: minmax(0, 1fr); margin-top: clamp(32px, 4vw, 64px); scroll-margin-top: calc(var(--header-h) + 32px); }
  .split .facts dl { position: static; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); column-gap: 24px; }
  .scroll-cue { display: inline-flex; align-items: center; gap: 12px; justify-self: start; margin-top: clamp(24px, 6vh, 72px); text-decoration: none; }
  .cue-arrow { display: inline-grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--line); border-radius: 50%; color: var(--fg); }
  :global(html:not(.no-motion)) .cue-arrow { animation: cue 2.2s var(--ease) infinite; }
  @keyframes cue { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .cue-arrow { animation: none !important; } }
  @media (max-width: 860px) {
    .split { grid-template-columns: minmax(0, 1fr); }
    .case-side { position: static; height: 60svh; order: 1; }
    .split .case-body { order: 2; }
    .split .case-head { min-height: 0; }
    .case-text { display: contents; }
  }
  .case-head { padding-top: clamp(24px, 5vw, 72px); padding-bottom: 40px; display: grid; gap: 20px; }
  .crumbs { display: flex; justify-content: space-between; gap: 16px; }
  .crumbs a { text-decoration: none; }
  .case-title { margin: 0; font-family: var(--font-display); font-weight: 800; font-stretch: 85%; letter-spacing: -.035em; line-height: .9; font-size: clamp(56px, 9vw, 150px); text-wrap: balance; }
  .case-sub { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .lead { margin: 0; font-size: clamp(20px, 2vw, 28px); line-height: 1.3; letter-spacing: -.01em; color: var(--muted); max-width: 40ch; }
  .visit { display: inline-flex; align-items: center; gap: 16px; padding: 8px 8px 8px 24px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-size: 17px; font-weight: 500; transition: border-color .3s, background .3s, color .3s; }
  .visit .disc { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--line); transition: transform .5s var(--ease), background .3s, color .3s; }
  .visit:hover { border-color: var(--fg); }
  .visit:hover .disc { background: var(--fg); color: var(--bg); transform: rotate(45deg); }

  .case-body { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 9fr); gap: 32px 64px; margin-top: clamp(48px, 6vw, 96px); }
  .facts dl { margin: 0; position: sticky; top: calc(var(--header-h) + 24px); }
  .facts dl > div { border-top: 1px solid var(--line); padding: 16px 0 22px; }
  .facts dt { margin-bottom: 8px; }
  .facts dd { margin: 0; font-size: 19px; line-height: 1.4; }
  .chips, .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; font-size: 14px; }
  .links { display: grid; gap: 8px; }
  .metrics { list-style: none; margin: 0 0 56px; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 24px; }
  .metrics li { border-top: 1px solid var(--line); padding-top: 16px; display: grid; gap: 10px; }
  .metrics .stat { font-size: clamp(56px, 6vw, 96px); }
  .overview, .case-prose :global(h2) { font-family: var(--font-display); font-weight: 800; font-stretch: 85%; text-transform: none; letter-spacing: -.03em; font-size: clamp(38px, 4.4vw, 64px); line-height: .95; margin: 0 0 20px; color: var(--fg); }
  /* Sub-sections (### in Markdown): clearly a step below the h2, but still above the body text. */
  .case-prose :global(h3) { font-family: var(--font-display); font-weight: 700; font-stretch: 90%; letter-spacing: -.02em; font-size: clamp(22px, 1.8vw, 27px); line-height: 1.1; margin: 36px 0 10px; }
  .case-prose { max-width: 62ch; }
  .case-showcase :global(.rv) { margin: 0; }
  /* Images and embeds placed in the case study get the full text width. */
  .case-prose :global(img) { max-width: 100%; height: auto; border-radius: 4px; }
  .case-prose :global(h2) { margin-top: 56px; }
  .case-prose :global(h2:first-child) { margin-top: 0; }
  .case-prose :global(p) { font-size: 19px; line-height: 1.65; color: var(--fg); }
  @media (max-width: 860px) { .case-body { grid-template-columns: minmax(0, 1fr); } .facts dl { position: static; } }

  .next { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding-block: 56px; text-decoration: none; }
  .next-title { font-size: clamp(56px, 10vw, 160px); }
  .next svg { transition: transform .5s var(--ease); }
  .next:hover svg { transform: translateX(10px); }
</style>
