---
import { existsSync } from 'node:fs';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ContactButton from '../../components/ui/ContactButton.astro';
import { localizedOne } from '../../lib/content';
import { site } from '../../lib/config';
import { t, href, langStaticPaths } from '../../lib/i18n';

export const getStaticPaths = langStaticPaths;
const { lang } = Astro.params as { lang: string };
const page = await localizedOne('pages', lang, 'about');
const Content = page ? (await render(page)).Content : null;
// site.yaml → portrait. Drop the file in /public and it replaces the placeholder; disable to go text-only.
const portrait = site.portrait;
const hasPortrait = portrait.enabled && existsSync(`public${portrait.src}`);
---
<Base lang={lang} page="about" title={page?.data.title ?? t(lang, 'nav.about')}>
  <div class="wrap">
    <PageHead title={page?.data.title ?? t(lang, 'nav.about')} metaLeft={site.location.city} />
    <div class:list={['about', { 'no-portrait': !portrait.enabled }]}>
      {portrait.enabled && (
        <figure class="portrait">
          {hasPortrait ? <img src={portrait.src} alt={portrait.alt || site.name} /> : <canvas width="480" height="600" data-art="portrait" aria-hidden="true"></canvas>}
          {!hasPortrait && <figcaption class="mono">Placeholder: add public{portrait.src}</figcaption>}
        </figure>
      )}
      <div class="copy">
        {page?.data.lead && <p class="statement">{page.data.lead}</p>}
        <div class="prose-site">{Content && <Content />}</div>
        <div class="actions">
          <a class="btn" href={href(lang, 'resume')}><span>■</span>{t(lang, 'cta.viewResume')}</a>
          <ContactButton lang={lang} label={t(lang, 'cta.talk')} />
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; padding-block: 56px 112px; }
  .portrait { margin: 0; position: relative; aspect-ratio: 4 / 5; max-width: 100%; overflow: hidden; border-radius: 4px; background: #EDEDED; align-self: start; }
  .portrait canvas, .portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); }
  .portrait figcaption { position: absolute; left: 12px; bottom: 12px; background: #fff; color: #000; padding: 5px 10px; border-radius: 999px; text-transform: none; letter-spacing: .04em; }
  .copy { display: grid; gap: 32px; align-content: start; min-width: 0; }
  .statement { font-family: var(--font-display); font-weight: 500; font-size: clamp(28px, 3.4vw, 52px); letter-spacing: -.035em; line-height: 1.04; margin: 0; text-wrap: balance; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .about.no-portrait { grid-template-columns: minmax(0, 1fr); max-width: 72ch; }
  @media (max-width: 860px) { .about { grid-template-columns: minmax(0, 1fr); } }
</style>
