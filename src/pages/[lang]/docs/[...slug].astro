---
import { getCollection } from 'astro:content';
import DocsPage from '../../../components/DocsPage.astro';
import { languages } from '../../../lib/i18n';

// Every docs page except the home (index.astro), at its folder path: /docs/writing/blog/.
export async function getStaticPaths() {
  const ids = (await getCollection('docs')).map((d) => d.id).filter((id) => id !== 'index');
  return languages.flatMap((lang) => ids.map((slug) => ({ params: { lang, slug } })));
}
const { lang, slug } = Astro.params as { lang: string; slug: string };
---
<DocsPage lang={lang} slug={slug} />
