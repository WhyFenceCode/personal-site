  /* colour */
  --ink: #0B0B0B;  --paper: #E6E6E6;  --night: #161616;  --white: #FFFFFF;
  --muted: #555555;  --muted-dark: #A0A0A0;
  --line: #CBCBCB;   --line-dark: #2E2E2E;
