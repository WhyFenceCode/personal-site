  --font-serif:   "Instrument Serif", Georgia, serif;
  --font-mono:    "DM Mono", ui-monospace, Menlo, monospace;

  /* corners */
  --r-mark: 0;  --r-chip: 3px;  --r-img: 4px;  --r-pop: 6px;
  --r-tile: 8px;  --r-frame: 10px;  --r-sheet: 16px;  --r-pill: 999px;

  /* lines */
