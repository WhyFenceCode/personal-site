  /* space */
  --gutter: 16px;  /* 28px from 720px */
  --header-h: 64px;
  --section-y: clamp(64px, 8vw, 120px);

  /* motion */
  --ease: cubic-bezier(.2, .7, .1, 1);
  --t-quick: .2s;  --t-move: .45s;  --t-reveal: .8s;
}

.display { font: 800 1em/.84 var(--font-display); font-stretch: 87.5%;
           letter-spacing: -.02em; text-transform: uppercase; }
.mono    { font: 400 12px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
body     { font: 400 17px/1.55 var(--font-sans); }`}</code></pre>
