---
import ContactButton from '../components/ui/ContactButton.astro';
import { site } from '../lib/config';
import { t, href, type Lang } from '../lib/i18n';

interface Props { lang: Lang; tone: 'light' | 'dark' }
const { lang, tone } = Astro.props;
---
<section class:list={['home-section', `tone-${tone}`]} id="contact" aria-labelledby="contact-title">
  <div class="section wrap contact">
    <div class="eyebrow mono">{t(lang, 'sections.contact.eyebrow')}</div>
    <h2 class="big" id="contact-title">{t(lang, 'sections.contact.title')}</h2>
    <div class="mail">
      <span class="addr" id="contact-email">{site.email}</span>
      <button class="copy" type="button" data-copy={site.email} data-copy-target="contact-email" data-copied={t(lang, 'cta.copied')}>
        <span data-copy-label>{t(lang, 'cta.copy')}</span>
      </button>
    </div>
    <div class="contact-actions">
      <ContactButton lang={lang} label={t(lang, 'cta.email')} to={`mailto:${site.email}`} />
      <a class="link" href={href(lang, 'resume')}>{t(lang, 'cta.viewResume')}</a>
    </div>
  </div>
</section>

<style>
  .contact { display: grid; gap: 32px; }
  .big { font-family: var(--font-display); font-weight: 800; font-stretch: 75%; text-transform: uppercase; letter-spacing: -.02em; line-height: .82; font-size: clamp(76px, 18vw, 300px); margin: 0; }
  .mail { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .addr { font-size: clamp(22px, 3vw, 40px); letter-spacing: -.02em; user-select: all; overflow-wrap: anywhere; }
  .copy { background: none; color: inherit; border: 1.5px solid currentColor; border-radius: 999px; padding: 10px 16px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; cursor: pointer; }
  .copy:hover { background: var(--fg); color: var(--bg); }
  .contact-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
</style>
