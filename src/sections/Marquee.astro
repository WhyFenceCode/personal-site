---
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; tone: 'light' | 'dark'; items?: string[] }
const { tone, items = ['Interface design', 'Front-end', 'Motion', 'Accessibility', 'Design systems', 'WebGL'] } = Astro.props;
---
<div class:list={['marquee', `tone-${tone}`]}>
  <p class="sr-only">{items.join(', ')}</p>
  <div class="marquee-track" aria-hidden="true">
    {[...items, ...items].map((i) => <span>{i}</span>)}
  </div>
  <button class="marquee-pause mono" type="button" data-marquee-pause aria-pressed="false" data-pause="Pause" data-play="Play" aria-label={`Pause scrolling text`}>Pause</button>
</div>

<style>
  .marquee { overflow: hidden; border-block: 1px solid var(--line); padding-block: 22px; position: relative; }
  .marquee-track { display: flex; width: max-content; animation: slide 38s linear infinite; }
  .marquee:hover .marquee-track, .marquee:global(.paused) .marquee-track { animation-play-state: paused; }
  .marquee-track span { font-family: var(--font-display); font-weight: 800; font-stretch: 75%; text-transform: uppercase; font-size: clamp(40px, 6vw, 88px); line-height: 1; padding-right: .5em; display: inline-flex; align-items: center; gap: .5em; white-space: nowrap; }
  .marquee-track span::after { content: ""; width: .28em; height: .28em; background: currentColor; }
  .marquee-track span:nth-child(even) { -webkit-text-stroke: 1.5px currentColor; color: transparent; }
  @keyframes slide { to { transform: translateX(-50%); } }
  .marquee-pause { position: absolute; right: var(--gutter-r); top: 50%; transform: translateY(-50%); background: var(--bg); color: var(--fg); border: 1.5px solid var(--fg); border-radius: 999px; padding: 6px 12px; cursor: pointer; }
</style>
